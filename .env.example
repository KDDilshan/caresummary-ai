# Copy this file to ".env" (same folder) and fill in the values.
# .env is in .gitignore, so your real key is never pushed to GitHub.

# Free key from https://aistudio.google.com/apikey  (needed for AI summary and Q&A)
GEMINI_API_KEY=
# Optional: which Gemini model to use
GEMINI_MODEL=gemini-2.5-flash

# Optional: fixed secret for login tokens (32+ characters). Empty = random each restart.
JWT_SECRET=

# Optional: change the demo passwords
DEMO_DOCTOR_PASSWORD=doctor123
DEMO_ADMIN_PASSWORD=admin123
