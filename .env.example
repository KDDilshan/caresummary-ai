# Copy this file to ".env" (same folder) and fill in the values.
# .env is in .gitignore, so your real key is never pushed to GitHub.

# Free key from https://aistudio.google.com/apikey  (needed for AI summary and Q&A)
GEMINI_API_KEY=
# Optional: which Gemini model to use
GEMINI_MODEL=gemini-flash-lite-latest

# Login: "keycloak" (default, needs the keycloak container) or "local" (built-in demo login, no Keycloak)
AUTH_MODE=keycloak
# Keycloak realm address (token "iss" must match it exactly)
KEYCLOAK_ISSUER=http://localhost:8180/realms/caresummary
# Keycloak admin console login (http://localhost:8180)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Local mode only: fixed secret for login tokens (32+ characters). Empty = random each restart.
JWT_SECRET=

# Local mode only: change the demo passwords (Keycloak users are in keycloak/caresummary-realm.json)
DEMO_DOCTOR_PASSWORD=doctor123
DEMO_ADMIN_PASSWORD=admin123

# Optional: send app metrics to AWS CloudWatch (see docs/HOW-IT-WORKS.md, section 10)
CLOUDWATCH_ENABLED=false
AWS_REGION=ap-south-1
# Keys of an IAM user that may only call cloudwatch:PutMetricData. Leave empty to use ~/.aws/credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
